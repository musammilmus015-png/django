{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Heartwise Local Preview",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoExit",
				"-Command",
				".\\.venv\\Scripts\\python.exe manage.py migrate --noinput --settings=heart_disease_project.preview_settings; if ($LASTEXITCODE -eq 0) { .\\.venv\\Scripts\\python.exe manage.py runserver 127.0.0.1:8000 --settings=heart_disease_project.preview_settings }"
			],
			"options": {
				"env": {
					"DJANGO_SECRET_KEY": "local-preview-only-key",
					"DJANGO_DEBUG": "True"
				}
			},
			"isBackground": true
		}
	]
}